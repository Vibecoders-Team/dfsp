# -------------------------
# DFSP deployment defaults
# -------------------------

REGISTRY_HOST=registry.example.com
SERVICE_BACKEND=dfsp-backend
BRANCH_NAME_LOWER=main

# Domain
DFSP_DOMAIN=example.com

# API defaults
API_HOST=0.0.0.0
API_PORT=8000

# Database
DB_USER=dfsp
DB_PASSWORD=replace_db_password
DB_NAME=dfsp
DB_HOST=db
DB_PORT=5432
DB_HOST_PORT=55432
POSTGRES_DSN=postgresql+psycopg://dfsp:replace_db_password@db:5432/dfsp

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_DSN=redis://redis:6379/0
REDIS_HOST_PORT=56379

# Blockchain / RPC
CHAIN_ID=31337
CHAIN_RPC_URL=http://chain:8545
CHAIN_PUBLIC_RPC_URL=https://rpc.example.com
RPC_URL=http://chain:8545
DEPLOY_OUT=/shared/deployment.json

# IPFS
IPFS_PROFILE=server
IPFS_API=http://ipfs:5001/api/v0
IPFS_GATEWAY_INTERNAL=http://ipfs:8080
IPFS_PUBLIC_GATEWAY=https://ipfs.example.com
IPFS_API_HOST_PORT=5002
IPFS_GATEWAY_HOST_PORT=8082

# JWT / auth
JWT_SECRET=replace_jwt_secret

# Frontend build env
VITE_API_BASE=https://example.com/api
VITE_CHAIN_ID=31337
VITE_CHAIN_RPC_URL=https://rpc.example.com
VITE_IPFS_PUBLIC_GATEWAY=https://ipfs.example.com
VITE_MINI_NAV_HMAC_SECRET=replace_nav_hmac
VITE_TONCONNECT_MANIFEST=https://example.com/tonconnect-manifest.json
VITE_WALLETCONNECT_PROJECT_ID=replace_wc_id
TONCONNECT_APP_URL=https://example.com
TONCONNECT_ICON_URL=https://example.com/icon.png
TONCONNECT_TERMS_URL=https://example.com/terms
TONCONNECT_APP_NAME=DFSP Example
TON_LOGIN_ALLOW_UNVERIFIED=0
VITE_LANDING_ENABLED=true

# Blockscout
BLOCKSCOUT_SECRET_KEY_BASE=replace_blockscout_secret
EXPLORER_DB_PASSWORD=replace_explorer_db_password

# Relayer queues
RELAYER_HIGH_QUEUE=relayer.high
RELAYER_DEFAULT_QUEUE=relayer.default

# Remote deployment
DEV_SSH_USER=deploy
DEV_SSH_HOST=server.example.com
DEV_REMOTE_DIR=/opt/dfsp
DEV_STATIC_DIR=/opt/dfsp/frontend/build

# Telegram bot
BOT_MODE=dev
BOT_TOKEN=replace_bot_token
DFSP_API_URL=http://api:8000
DFSP_API_TOKEN=
WEBHOOK_SECRET=replace_webhook_secret
PUBLIC_WEB_ORIGIN=https://example.com
BOT_REDIS_DSN=redis://redis:6379/0
BOT_QUEUE_DSN=redis://redis:6379/0
BOT_PROM_PORT=8002
BOT_APP_PORT=8081
BOT_APP_HOST=0.0.0.0

