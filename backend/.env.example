# Core API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
API_AUTO_MIGRATE=true
LOG_FORMAT=console

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dfsp
DB_USER=dfsp
DB_PASSWORD=replace_me
POSTGRES_DSN=postgresql+psycopg://dfsp:replace_me@localhost:5432/dfsp
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100

# Chain / RPC
CHAIN_ID=31337
CHAIN_RPC_URL=http://localhost:8545
CHAIN_PUBLIC_RPC_URL=http://localhost:8545
REGISTRY_CONTRACT_NAME=FileRegistry
DEPLOY_OUT=./shared/deployment.json
RELAYER_PRIVATE_KEY=0xreplace_with_private_key
RELAYER_CONCURRENCY=2
RELAYER_HIGH_QUEUE=relayer.high
RELAYER_DEFAULT_QUEUE=relayer.default

# IPFS
IPFS_API_URL=http://localhost:5001/api/v0
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_PUBLIC_GATEWAY_URL=http://localhost:8080
IPFS_PROFILE=server

# Security / Auth
JWT_SECRET=replace_with_jwt_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS="http://localhost:5173"

# PoW / Quotas
POW_ENABLED=false
POW_DIFFICULTY_BASE=18
POW_CHALLENGE_TTL_SECONDS=300
QUOTA_DOWNLOAD_BYTES_PER_DAY=2000000000
QUOTA_META_TX_PER_DAY=100

# Anchoring / Tasks
ANCHOR_PERIOD_MIN=30

# Vite build defaults (if backend builds frontend)
VITE_API_BASE=http://localhost:8000/api
VITE_CHAIN_ID=31337
VITE_CHAIN_RPC_URL=http://localhost:8545
VITE_IPFS_PUBLIC_GATEWAY=http://localhost:8080
VITE_WALLETCONNECT_PROJECT_ID=replace_wc_id
VITE_CHAIN_NAME=DFSP Local
VITE_CHAIN_BLOCK_EXPLORER_URL=http://localhost:3000
VITE_TONCONNECT_MANIFEST=https://example.com/tonconnect-manifest.json
VITE_MINI_NAV_HMAC_SECRET=replace_with_hmac_secret
VITE_LANDING_ENABLED=false

# Observability
GRAFANA_PUBLIC_URL=http://localhost:3001
GRAFANA_ADMIN_PASSWORD=replace_grafana_password

# TON Connect
tONCONNECT_APP_NAME=DFSP Local
TONCONNECT_APP_URL=http://localhost:5173
TONCONNECT_ICON_URL=http://localhost:5173/logo.png
TONCONNECT_TERMS_URL=http://localhost:5173/terms
TON_LOGIN_ALLOW_UNVERIFIED=true

# Telegram bot integration
BOT_MODE=dev
BOT_TOKEN=replace_bot_token
DFSP_API_URL=http://localhost:8000
DFSP_API_TOKEN=
WEBHOOK_SECRET=replace_webhook_secret
PUBLIC_WEB_ORIGIN=http://localhost:5173
BOT_REDIS_DSN=redis://localhost:6379/0
BOT_QUEUE_DSN=redis://localhost:6379/0
BOT_PROM_PORT=8001
BOT_APP_PORT=8080
BOT_APP_HOST=0.0.0.0

