# API Backend URL
VITE_API_BASE=http://localhost:8000

# IPFS Gateway for public access
VITE_IPFS_PUBLIC_GATEWAY=http://localhost:8080

# WalletConnect & TonConnect
VITE_WALLETCONNECT_PROJECT_ID=wc_project_id_placeholder
VITE_TONCONNECT_MANIFEST=https://example.com/tonconnect-manifest.json
VITE_CHAIN_ID=31337
VITE_CHAIN_RPC_URL=https://rpc.example.com
VITE_CHAIN_NAME=Example Chain
VITE_CHAIN_BLOCK_EXPLORER_URL=https://explorer.example.com
VITE_MINI_NAV_HMAC_SECRET=replace_with_hmac_secret
VITE_LANDING_ENABLED=true
VITE_PUBLIC_ORIGIN=https://app.example.com

# Feature toggles
VITE_ENABLE_ANALYTICS=false

VITE_TONCONNECT_APP_NAME=DFSP Example
VITE_TONCONNECT_APP_URL=https://app.example.com
VITE_TONCONNECT_ICON_URL=https://app.example.com/icon.png
VITE_TONCONNECT_TERMS_URL=https://app.example.com/terms
TON_LOGIN_ALLOW_UNVERIFIED=false
